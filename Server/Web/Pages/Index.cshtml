@page
@model IndexModel

<p>Server running: @Model.IsoServer.Server.IsRunning()</p>

<h3>Worlds</h3>
<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Created</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var entry in Model.IsoServer.Worlds)
    {
        <tr>
            <td>@entry.Key</td>
            <td>@entry.Value.Created</td>
        </tr>
    }
    </tbody>
</table>
